[Unit]
Description=HexStrike Telegram Bot
After=network.target hexstrike.service
Wants=hexstrike.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt
EnvironmentFile=-/etc/hexstrike-bot.env
ExecStart=/opt/hexstrike-env/bin/python /opt/hexstrike-bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
